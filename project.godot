; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="UMBRAL: El Último Intervalo"
config/version="0.1.0"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Controles="*res://scripts/core/controles.gd"
Fase="*res://scripts/core/fase/gestor_fase.gd"
Partida="*res://scripts/core/partida/gestor_partida.gd"
Salas="*res://scripts/core/mundo/gestor_salas.gd"
Impactos="*res://scripts/core/efectos/director_impactos.gd"

[debug]

gdscript/warnings/untyped_declaration=1

[layer_names]

3d_physics/layer_1="mundo"
3d_physics/layer_2="realidad"
3d_physics/layer_3="desfase"
3d_physics/layer_4="jugador"
3d_physics/layer_5="enemigos"
3d_physics/layer_6="dano_enemigo"
3d_physics/layer_7="dano_jugador"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
