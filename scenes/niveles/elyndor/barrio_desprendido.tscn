transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -11.0, 0.0, 0)
id = &"elyndor_campana_huerfana"
titulo = "Eco: la campana huérfana"
texto = "Una muchedumbre se agolpa bajo un campanario. Escuchan, con la mirada alzada, el repique de una campana que ya no existe. En sus rostros, el miedo de un olvido repentino."

[node name="EcoCartografo" parent="." instance=ExtResource("40_eco")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 38.0, 1.5, 0)
id = &"elyndor_pasaje_borrado"
titulo = "Eco: el pasaje borrado"
texto = "Un cartógrafo traza líneas sobre el suelo de piedra. Dibuja una puerta donde hoy solo hay una pared ciega. Antes de desvanecerse, golpea la piedra tres veces."

[node name="EcoArchivista" parent="." instance=ExtResource("40_eco")]
